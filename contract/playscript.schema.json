{
  "$defs": {
    "ActivateMove": {
      "additionalProperties": false,
      "properties": {
        "ability_text_has": {
          "pattern": "\\S",
          "title": "Ability Text Has",
          "type": "string"
        },
        "answers": {
          "items": {
            "$ref": "#/$defs/Answer"
          },
          "maxItems": 3,
          "title": "Answers",
          "type": "array"
        },
        "kind": {
          "const": "activate",
          "title": "Kind",
          "type": "string"
        },
        "sacrifice": {
          "default": null,
          "oneOf": [
            {
              "enum": [
                "source",
                "none"
              ],
              "type": "string"
            },
            {
              "$ref": "#/$defs/SacrificeChoice"
            }
          ],
          "title": "Sacrifice"
        },
        "source": {
          "$ref": "#/$defs/ZonedCard"
        },
        "targets": {
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/CardTarget"
              },
              {
                "$ref": "#/$defs/PlayerTarget"
              }
            ]
          },
          "maxItems": 6,
          "title": "Targets",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "source",
        "ability_text_has"
      ],
      "title": "ActivateMove",
      "type": "object"
    },
    "Affordable": {
      "additionalProperties": false,
      "description": "`{extra: n}` (O7): mana value <= untapped mana + `extra`. `extra` 0\nasks whether the card is affordable with untapped mana alone.",
      "properties": {
        "extra": {
          "minimum": 0,
          "title": "Extra",
          "type": "integer"
        }
      },
      "required": [
        "extra"
      ],
      "title": "Affordable",
      "type": "object"
    },
    "Answer": {
      "additionalProperties": false,
      "description": "How to answer one pending decision of kind `decision`. A pay-amount\ndecision takes `amount` alone; `choice` (O6) is taken only by\n`CHOICE_DECISION_KINDS`; every other kind takes `pick`, `accept`,\n`to_graveyard` or `to_bottom`.",
      "properties": {
        "accept": {
          "default": null,
          "title": "Accept",
          "type": "boolean"
        },
        "amount": {
          "default": null,
          "oneOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "const": "max",
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "choice": {
          "default": null,
          "pattern": "\\S",
          "title": "Choice",
          "type": "string"
        },
        "decision": {
          "enum": [
            "assign_combat_damage",
            "choose_a_mode",
            "choose_a_quality",
            "choose_cards",
            "choose_targets",
            "declare_attackers",
            "declare_blockers",
            "may",
            "mulligan",
            "opening_hand_action",
            "order_triggers",
            "pay_energy",
            "pay_energy_amount",
            "pay_life",
            "pay_life_amount",
            "pay_mana",
            "put_on_top_or_bottom",
            "scry",
            "surveil"
          ],
          "title": "Decision",
          "type": "string"
        },
        "pick": {
          "$ref": "#/$defs/Pick",
          "default": null
        },
        "to_bottom": {
          "$ref": "#/$defs/Selector",
          "default": null
        },
        "to_graveyard": {
          "$ref": "#/$defs/Selector",
          "default": null
        }
      },
      "required": [
        "decision"
      ],
      "title": "Answer",
      "type": "object"
    },
    "AnswerMove": {
      "additionalProperties": false,
      "description": "Answers for a decision already pending.",
      "properties": {
        "answers": {
          "items": {
            "$ref": "#/$defs/Answer"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Answers",
          "type": "array"
        },
        "kind": {
          "const": "answer",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "answers"
      ],
      "title": "AnswerMove",
      "type": "object"
    },
    "CardTarget": {
      "additionalProperties": false,
      "description": "A card or permanent target: what `select` matches, on `side`.",
      "properties": {
        "select": {
          "$ref": "#/$defs/Selector"
        },
        "side": {
          "enum": [
            "me",
            "opponent",
            "any"
          ],
          "title": "Side",
          "type": "string"
        }
      },
      "required": [
        "select",
        "side"
      ],
      "title": "CardTarget",
      "type": "object"
    },
    "CastMove": {
      "additionalProperties": false,
      "properties": {
        "answers": {
          "items": {
            "$ref": "#/$defs/Answer"
          },
          "maxItems": 3,
          "title": "Answers",
          "type": "array"
        },
        "card": {
          "$ref": "#/$defs/ZonedCard"
        },
        "cost": {
          "default": null,
          "enum": [
            "normal",
            "adventure",
            "airbend",
            "bestow",
            "dash",
            "disguise",
            "escape",
            "evoke",
            "flashback",
            "foretell",
            "harmonize",
            "impending",
            "madness",
            "mayhem",
            "megamorph",
            "morph",
            "plot",
            "printed",
            "warp"
          ],
          "title": "Cost",
          "type": "string"
        },
        "kind": {
          "const": "cast",
          "title": "Kind",
          "type": "string"
        },
        "mana": {
          "const": "auto",
          "default": null,
          "title": "Mana",
          "type": "string"
        },
        "targets": {
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/CardTarget"
              },
              {
                "$ref": "#/$defs/PlayerTarget"
              }
            ]
          },
          "maxItems": 6,
          "title": "Targets",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "card"
      ],
      "title": "CastMove",
      "type": "object"
    },
    "Comparison": {
      "additionalProperties": false,
      "description": "`{op, n}` against a number on the card.",
      "properties": {
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "op": {
          "enum": [
            ">=",
            "<=",
            "==",
            "!=",
            ">",
            "<"
          ],
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "op",
        "n"
      ],
      "title": "Comparison",
      "type": "object"
    },
    "CountCondition": {
      "additionalProperties": false,
      "description": "How many cards matching `select` are in a zone, by side. A hidden zone\n(hand, library, sideboard) must name `me` or `opponent`.",
      "properties": {
        "kind": {
          "const": "count",
          "title": "Kind",
          "type": "string"
        },
        "known_only": {
          "default": null,
          "title": "Known Only",
          "type": "boolean"
        },
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "op": {
          "enum": [
            ">=",
            "<=",
            "==",
            "!=",
            ">",
            "<"
          ],
          "title": "Op",
          "type": "string"
        },
        "select": {
          "$ref": "#/$defs/Selector"
        },
        "side": {
          "enum": [
            "me",
            "opponent",
            "any"
          ],
          "title": "Side",
          "type": "string"
        },
        "zone": {
          "enum": [
            "battlefield",
            "graveyard",
            "exile",
            "hand",
            "stack",
            "library",
            "sideboard"
          ],
          "title": "Zone",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "zone",
        "side",
        "op",
        "n",
        "select"
      ],
      "title": "CountCondition",
      "type": "object"
    },
    "CounterComparison": {
      "additionalProperties": false,
      "description": "`{name, op, n}`: how many counters of one kind (not a card name).",
      "properties": {
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "name": {
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "op": {
          "enum": [
            ">=",
            "<=",
            "==",
            "!=",
            ">",
            "<"
          ],
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "name",
        "op",
        "n"
      ],
      "title": "CounterComparison",
      "type": "object"
    },
    "InputCondition": {
      "additionalProperties": false,
      "description": "A fact only the agent knows: a declared input or `opposing_archetype`.",
      "properties": {
        "kind": {
          "const": "input",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "op": {
          "enum": [
            "eq",
            "ne",
            "in",
            "not_in",
            "<",
            "<=",
            ">",
            ">="
          ],
          "title": "Op",
          "type": "string"
        },
        "value": {
          "title": "Value"
        }
      },
      "required": [
        "kind",
        "name",
        "op",
        "value"
      ],
      "title": "InputCondition",
      "type": "object"
    },
    "LandCard": {
      "additionalProperties": false,
      "properties": {
        "prefer": {
          "default": null,
          "items": {
            "$ref": "#/$defs/Selector"
          },
          "maxItems": 4,
          "title": "Prefer",
          "type": "array"
        },
        "select": {
          "$ref": "#/$defs/Selector"
        },
        "ties": {
          "const": "any",
          "default": null,
          "title": "Ties",
          "type": "string"
        }
      },
      "required": [
        "select"
      ],
      "title": "LandCard",
      "type": "object"
    },
    "LandDropCondition": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "land_drop_available",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "LandDropCondition",
      "type": "object"
    },
    "LifeCondition": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "life",
          "title": "Kind",
          "type": "string"
        },
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "op": {
          "enum": [
            ">=",
            "<=",
            "==",
            "!=",
            ">",
            "<"
          ],
          "title": "Op",
          "type": "string"
        },
        "side": {
          "enum": [
            "me",
            "opponent",
            "any"
          ],
          "title": "Side",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "side",
        "op",
        "n"
      ],
      "title": "LifeCondition",
      "type": "object"
    },
    "MissingFrom": {
      "additionalProperties": false,
      "description": "`{zones, side, by}`: the candidate matches only when no card on `side`\nin `zones` shares what `by` compares with it - its subtypes (those the\nselector's own `subtypes_any` lists, when it lists any) or its name. A\ncomparison between objects, never a name written in the script.",
      "properties": {
        "by": {
          "enum": [
            "subtype",
            "name"
          ],
          "title": "By",
          "type": "string"
        },
        "side": {
          "enum": [
            "me",
            "opponent"
          ],
          "title": "Side",
          "type": "string"
        },
        "zones": {
          "items": {
            "enum": [
              "battlefield",
              "graveyard",
              "exile",
              "hand",
              "stack",
              "library",
              "sideboard"
            ],
            "type": "string"
          },
          "maxItems": 7,
          "minItems": 1,
          "title": "Zones",
          "type": "array"
        }
      },
      "required": [
        "zones",
        "side",
        "by"
      ],
      "title": "MissingFrom",
      "type": "object"
    },
    "Pick": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "default": null,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "prefer": {
          "default": null,
          "items": {
            "$ref": "#/$defs/Selector"
          },
          "maxItems": 4,
          "title": "Prefer",
          "type": "array"
        },
        "select": {
          "$ref": "#/$defs/Selector"
        },
        "ties": {
          "const": "any",
          "default": null,
          "title": "Ties",
          "type": "string"
        }
      },
      "required": [
        "select"
      ],
      "title": "Pick",
      "type": "object"
    },
    "PlayLandMove": {
      "additionalProperties": false,
      "properties": {
        "answers": {
          "items": {
            "$ref": "#/$defs/Answer"
          },
          "maxItems": 3,
          "title": "Answers",
          "type": "array"
        },
        "card": {
          "$ref": "#/$defs/LandCard"
        },
        "kind": {
          "const": "play_land",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "card"
      ],
      "title": "PlayLandMove",
      "type": "object"
    },
    "PlayerTarget": {
      "additionalProperties": false,
      "description": "A player target: the viewer or an opponent.",
      "properties": {
        "player": {
          "enum": [
            "me",
            "opponent"
          ],
          "title": "Player",
          "type": "string"
        }
      },
      "required": [
        "player"
      ],
      "title": "PlayerTarget",
      "type": "object"
    },
    "SacrificeChoice": {
      "additionalProperties": false,
      "description": "What an activation cost's own \"Sacrifice a ...\" piece sacrifices:\npermanents the activating player controls matching `select`, `count` of\nthem (the cost's own number when left out), best first by `prefer`.",
      "properties": {
        "count": {
          "default": null,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "prefer": {
          "default": null,
          "items": {
            "$ref": "#/$defs/Selector"
          },
          "maxItems": 4,
          "title": "Prefer",
          "type": "array"
        },
        "select": {
          "$ref": "#/$defs/Selector"
        },
        "ties": {
          "const": "any",
          "default": null,
          "title": "Ties",
          "type": "string"
        }
      },
      "required": [
        "select"
      ],
      "title": "SacrificeChoice",
      "type": "object"
    },
    "Selector": {
      "additionalProperties": false,
      "description": "Characteristics of one card, all optional, combined with AND. No field\ntakes a card name: type words come from the type line, text fields are\ntemplate phrases matched case-insensitively, and `missing_from` compares\nthe candidate with the cards already in some zones.",
      "properties": {
        "ability_text_has": {
          "default": null,
          "pattern": "\\S",
          "title": "Ability Text Has",
          "type": "string"
        },
        "affordable": {
          "$ref": "#/$defs/Affordable",
          "default": null
        },
        "colors_any": {
          "default": null,
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 15,
          "title": "Colors Any",
          "type": "array"
        },
        "counters": {
          "$ref": "#/$defs/CounterComparison",
          "default": null
        },
        "enters_any": {
          "default": null,
          "items": {
            "enum": [
              "untapped",
              "tapped",
              "untapped_if_paid"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "title": "Enters Any",
          "type": "array"
        },
        "keywords_any": {
          "default": null,
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 15,
          "title": "Keywords Any",
          "type": "array"
        },
        "land_face": {
          "default": null,
          "title": "Land Face",
          "type": "boolean"
        },
        "mana_value": {
          "$ref": "#/$defs/Comparison",
          "default": null
        },
        "missing_from": {
          "$ref": "#/$defs/MissingFrom",
          "default": null
        },
        "oracle_has": {
          "default": null,
          "pattern": "\\S",
          "title": "Oracle Has",
          "type": "string"
        },
        "power": {
          "$ref": "#/$defs/Comparison",
          "default": null
        },
        "searches_for_any": {
          "default": null,
          "items": {
            "enum": [
              "Plains",
              "Island",
              "Swamp",
              "Mountain",
              "Forest"
            ],
            "type": "string"
          },
          "maxItems": 5,
          "title": "Searches For Any",
          "type": "array"
        },
        "subtypes_any": {
          "default": null,
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 15,
          "title": "Subtypes Any",
          "type": "array"
        },
        "supertypes_any": {
          "default": null,
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 15,
          "title": "Supertypes Any",
          "type": "array"
        },
        "tapped": {
          "default": null,
          "title": "Tapped",
          "type": "boolean"
        },
        "toughness": {
          "$ref": "#/$defs/Comparison",
          "default": null
        },
        "types_all": {
          "default": null,
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 15,
          "title": "Types All",
          "type": "array"
        },
        "types_any": {
          "default": null,
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 15,
          "title": "Types Any",
          "type": "array"
        },
        "unlocks": {
          "default": null,
          "title": "Unlocks",
          "type": "boolean"
        },
        "unlocks_by_search": {
          "default": null,
          "title": "Unlocks By Search",
          "type": "boolean"
        }
      },
      "title": "Selector",
      "type": "object"
    },
    "StackTopCondition": {
      "additionalProperties": false,
      "description": "The top object of the stack: whose, and matching `select`.",
