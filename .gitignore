# Generated by scripts/postgres-password.sh for local development postgres.
.postgres-password

# Agent worktrees (transient, one per subagent). Not ignoring these means
# `ruff check .` lints every other concurrently-running agent's in-progress
# tree and fails on their half-written code, and `git status` is buried under
# a screenful of untracked directories. The engine repo already ignores this
# exact path; this line just brings the two repos back in step.
.claude/worktrees/

# Local SDD workflow ledger (never committed).
.superpowers/
