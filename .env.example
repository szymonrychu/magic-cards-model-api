# Copy to .env and fill in. .env is gitignored.

# The key claude authenticates with inside the agent container.
# ONE of the two below. They are different credentials read from different
# variables, and putting a setup-token in ANTHROPIC_API_KEY gets a 401.
#
# A Claude Code subscription token, from `claude setup-token`:
CLAUDE_CODE_OAUTH_TOKEN=
# ...or a console API key:
ANTHROPIC_API_KEY=

# Your deck guides. Mounted read-only at /guides in every container.
MTG_DECKS=/Users/szymonri/Documents/mtg-decks

# Which model the agent plays with.
CLAUDE_MODEL=sonnet

# How hard the agent thinks: low, medium, high, xhigh, max.
CLAUDE_EFFORT=high

# Optional thinking-token budget for the agent. Blank leaves Claude Code's own
# default; 0 disables thinking where the model allows it.
CLAUDE_MAX_THINKING_TOKENS=

# Pin the claude CLI; `latest` rebuilds that layer on every no-cache build.
CLAUDE_CODE_VERSION=latest

# Target architecture. linux/amd64 for Intel Macs and x86 servers;
# set linux/arm64 on Apple Silicon for a native (much faster) build.
DOCKER_PLATFORM=linux/amd64

# The agent container runs as a non-root user - claude refuses bypass
# permissions mode as root. Match these to your host uid/gid (`id -u`,
# `id -g`) if the bind-mounted ./memory ends up unwritable.
AGENT_UID=1000
AGENT_GID=1000

# How loud the compose log is.
#
# ACCESS_LOG_QUIET=1 (the default) drops uvicorn access lines for SUCCESSFUL
# reads of the polled routes on all three services - /api/health, /healthz,
# /readyz, /status, /api/games/{id} and /api/ui/games/{id}/ai-seat/status.
# Those four polls are the entire idle log. Mutations always print, and so
# does any response that is not 2xx/3xx. Set 0 for the full access log.
ACCESS_LOG_QUIET=1

# How much of the agent's own activity the agent container prints, tailed off
# the live claude transcript: off | turns | messages | tools (the default,
# which adds every tool call and every tool failure).
AGENT_LOG_LEVEL=tools

# postgres (T9). Only docker-compose's `postgres`/`migrate` services and
# `mise run db:migrate`/`test:pg` read these - `game` does not talk to
# postgres yet. Defaults (mtg/mtg/mtg) are already baked into docker-
# compose.yml, so these are only worth setting to override them.
POSTGRES_USER=mtg
POSTGRES_PASSWORD=mtg
POSTGRES_DB=mtg

# Leave blank, or set it to point `mise run test:pg` at a postgres you are
# already running yourself instead of the one it brings up via docker
# compose. Safe to leave set in .env even once you have: `mise run test`'s
# own task body unconditionally unsets this before running pytest, so the
# plain default suite stays docker-free regardless of what is in this file.
MCM_TEST_DATABASE_URL=
