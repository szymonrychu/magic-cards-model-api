          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "op",
        "n"
      ],
      "title": "UntappedManaCondition",
      "type": "object"
    },
    "When": {
      "additionalProperties": false,
      "properties": {
        "stack": {
          "enum": [
            "empty",
            "any"
          ],
          "title": "Stack",
          "type": "string"
        },
        "steps": {
