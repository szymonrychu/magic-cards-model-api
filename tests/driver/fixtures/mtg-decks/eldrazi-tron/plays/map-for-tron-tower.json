{
  "schema_version": 1,
  "id": "map-for-tron-tower",
  "name": "Crack the land-search artifact for a Tower when no Tower is out",
  "intent": "Applies whenever no Tower is on my battlefield and one is in my library: the Tower is fetched first because every incomplete set without one lacks it. Expedition Map shape. The three land-search plays walk one order - Tower, then Mine, then Power-Plant - each applying only when the subtypes before it are on my battlefield and its own is not, so they exclude each other on battlefield count ranges, never fetch a subtype already out, and none applies once all three are present. Three plays instead of one per missing set leaves half the six-active-plays cap free.",
  "priority": 60,
  "opposing_archetypes": [
    "*"
  ],
  "when": {
    "whose_turn": "mine",
    "steps": [
      "precombat_main"
    ],
    "stack": "empty"
  },
  "true": [
    {
      "kind": "count",
      "zone": "battlefield",
      "side": "me",
      "op": ">=",
      "n": 1,
      "select": {
        "types_all": [
          "Artifact"
        ],
        "tapped": false,
        "ability_text_has": "library for a land card"
      }
    },
    {
