# Copy to .env and fill in. .env is gitignored.

# The key claude authenticates with inside the agent container.
# ONE of the two below. They are different credentials read from different
# variables, and putting a setup-token in ANTHROPIC_API_KEY gets a 401.
#
# A Claude Code subscription token, from `claude setup-token`:
CLAUDE_CODE_OAUTH_TOKEN=
# ...or a console API key:
ANTHROPIC_API_KEY=

# Your deck guides, read-only, for the `game` service's own deck browsing.
# A real git clone of github.com/szymonrychu/mtg-decks, not a copy of its
# files. This is NOT what agent/driver read: they get a separate writable
# clone of the same repo, made fresh into the compose-managed `agent-guides`
# volume by the one-shot `guides-init` service (deploy/guides-clone.sh, the
# same script the k8s `guides` initContainer runs) - so the owner's own
# checkout here is never mounted writable into the agent. The driver reads
# the corpus revision from *that* checkout's `.guides-revision` stamp and
# stamps it into every game's briefing and plan file.
MTG_DECKS=/Users/szymonri/Documents/mtg-decks

# A fine-grained GitHub PAT that lets guides-init clone mtg-decks and lets
# the agent push a guide change it makes (a `boarding-plan.json` matchup edit
# or a NOTES.md update, pushed straight to mtg-decks main after the in-pod
# gates - see the README's "Handover" section). Create it at
# https://github.com/settings/personal-access-tokens/new:
#   - Resource owner: szymonrychu
#   - Repository access: Only select repositories -> szymonrychu/mtg-decks
#   - Repository permissions: Contents: Read and write; Metadata: Read-only
#     (mandatory). Everything else, including Workflows, stays at No access.
# Note the expiry you pick - a token that silently expires stops every clone
# and every handover push.
#
# The handover itself (pushing a guide change, notifying the buddy) runs when
# a game ends and when the driver's `/release` is called - never on a plain
# `docker compose stop`/`down`, which just stops the containers. See the
# README's "Handover" section.
MTG_DECKS_GH_PAT=

# Which game this compose agent is currently playing, for the git identity it
# commits guide changes under (`MTG_ROLE`/`MTG_GAME_ID`, consistent with the
# k8s seat Job's per-Job env - see docker-compose.yml). Compose runs one
# continuous agent recycled across matches rather than one Job per game, so
# this cannot be stamped once and stay right for every match the way a seat
# Job's can; leave it blank unless you are driving a script command by hand
# for a specific game.
MTG_GAME_ID=

# Which model the agent plays with.
CLAUDE_MODEL=sonnet

# How hard the agent thinks: low, medium, high, xhigh, max.
CLAUDE_EFFORT=high

# Optional thinking-token budget for the agent. Blank leaves Claude Code's own
# default; 0 disables thinking where the model allows it.
CLAUDE_MAX_THINKING_TOKENS=

# Pin the claude CLI; `latest` rebuilds that layer on every no-cache build.
CLAUDE_CODE_VERSION=latest

# Target architecture. linux/amd64 for Intel Macs and x86 servers;
# set linux/arm64 on Apple Silicon for a native (much faster) build.
DOCKER_PLATFORM=linux/amd64

# The agent container runs as a non-root user - claude refuses bypass
# permissions mode as root. Match these to your host uid/gid (`id -u`,
# `id -g`) if the bind-mounted ./memory ends up unwritable.
AGENT_UID=1000
AGENT_GID=1000

# How loud the compose log is.
#
# ACCESS_LOG_QUIET=1 (the default) drops uvicorn access lines for SUCCESSFUL
# reads of the polled routes on all three services - /api/health, /healthz,
# /readyz, /status, /api/games/{id} and /api/ui/games/{id}/ai-seat/status.
# Those four polls are the entire idle log. Mutations always print, and so
# does any response that is not 2xx/3xx. Set 0 for the full access log.
ACCESS_LOG_QUIET=1

# How much of the agent's own activity the agent container prints, tailed off
# the live claude transcript: off | turns | messages | tools (the default,
# which adds every tool call and every tool failure).
AGENT_LOG_LEVEL=tools

# postgres (T9). Only docker-compose's `postgres`/`migrate` services and
# `mise run db:migrate`/`test:pg` read these - `game` does not talk to
# postgres yet. The user and database default to `mtg` in docker-compose.yml;
# the password has no default and no committed value. `mise run test:pg`,
# `mise run compose` and `mise run db:migrate` all call
# scripts/postgres-password.sh, which generates one into the gitignored
# .postgres-password on first use and reuses it after. Set POSTGRES_PASSWORD
# here only to override that.
POSTGRES_USER=mtg
POSTGRES_PASSWORD=
POSTGRES_DB=mtg
# Because the password has no default, a bare `docker compose ...` cannot
# interpolate it and refuses to run - including `docker compose down -v`, which
# is how a stale volume survives a password change. Drive compose through mise:
# `mise run compose`, `mise run compose:down -- -v`, `mise run test:pg`,
# `mise run db:migrate`. That is the repo convention anyway.

# Leave blank, or set it to point `mise run test:pg` at a postgres you are
# already running yourself instead of the one it brings up via docker
# compose. Safe to leave set in .env even once you have: `mise run test`'s
# own task body unconditionally unsets this before running pytest, so the
# plain default suite stays docker-free regardless of what is in this file.
MCM_TEST_DATABASE_URL=
