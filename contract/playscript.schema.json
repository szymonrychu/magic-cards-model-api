    },
    "TurnCondition": {
      "additionalProperties": false,
      "description": "The view's `turn_number` op `n`: rounds of the table\n(`TurnMachine.turn_number`), so on my own turn it is my Nth turn, on the\nplay and on the draw alike - it does not advance until the rotation\nwraps back to the starting seat, so an extra turn (CR 500.7) never moves\nit. A null `turn_number` (pregame) never holds, whatever `op` is.",
      "properties": {
        "kind": {
          "const": "turn",
          "title": "Kind",
          "type": "string"
        },
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "op": {
          "enum": [
            ">=",
            "<=",
            "==",
            "!=",
            ">",
            "<"
          ],
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "op",
        "n"
      ],
      "title": "TurnCondition",
      "type": "object"
    },
    "UntappedManaCondition": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "untapped_mana",
          "title": "Kind",
          "type": "string"
        },
