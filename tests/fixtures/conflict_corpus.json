{
  "schema_version": 1,
  "description": "Tagged pairs for the play-conflict exclusivity algorithm shared by mtg-decks scripts/check_plays.py and the api's plays check. Each case is two play fragments (when, opposing_archetypes, true, false). An exclusive case lists every dimension that proves it (proven_by, in dimension order); a conflicting case proves none and lists the dimensions the pair overlaps on. The api copies this file byte-identical.",
  "dimensions": [
    {
      "letter": "a",
      "name": "whose_turn",
      "rule": "when.whose_turn is mine in one and theirs in the other"
    },
    {
      "letter": "b",
      "name": "steps",
      "rule": "when.steps sets do not intersect"
    },
    {
      "letter": "c",
      "name": "opposing_archetypes",
      "rule": "neither list holds * and the sets do not intersect"
    },
    {
      "letter": "d",
      "name": "stack",
      "rule": "one play's when.stack is empty and the other has a stack_top condition in true"
    },
    {
      "letter": "e",
      "name": "input",
      "rule": "an input condition in each play on the same name whose value sets cannot both hold; a false-list condition is negated first"
    },
    {
      "letter": "f",
      "name": "true_false",
      "rule": "a normalized condition is in one play's true and the other's false"
    },
    {
      "letter": "g",
      "name": "numeric_range",
      "rule": "count, zone_size, life, untapped_mana or int-input conditions on the same key whose ranges cannot overlap; a false-list condition is negated first"
    }
  ],
  "inputs": [
    {
      "name": "plan",
      "type": "enum",
      "values": [
        "aggro",
        "control"
      ],
      "description": "The line the agent has committed to this game.",
      "required": false
    },
    {
      "name": "hold_up_interaction",
      "type": "bool",
      "description": "Whether the agent prefers to keep mana open on the opponent's turn.",
      "required": false
    },
    {
      "name": "opponent_clock",
      "type": "int",
      "min": 0,
      "max": 10,
      "description": "Turns the agent expects the opponent to need to win.",
      "required": true
    }
  ],
  "matchup_keys": [
    "dimir-frog",
    "living-end"
  ],
